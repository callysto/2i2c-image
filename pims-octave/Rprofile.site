assign('localPkgDir', "~/R/x86_64-pc-linux-gnu-library/4.5", envir = globalenv())
dir.create(localPkgDir, recursive=TRUE, showWarnings = FALSE)

.libPaths(c(localPkgDir, .libPaths()))

local({
      r <- getOption("repos")
        r['CRAN'] <- 'https://mirror.csclub.uwaterloo.ca/CRAN/';
          options(repos = r)
})

